% mystyle.bbx
\ProvidesFile{thesis.bbx}[thesis bbx]
\RequireBibliographyStyle{numeric-comp}  % start from authoryear

% \ExecuteBibliographyOptions{url=false}

\ExecuteBibliographyOptions{%
  giveninits=true,
  minbibnames=3,%
  maxbibnames=6,%
  sorting=none,%
  url=false%
}

\DeclareFieldFormat{doi}{%
  \mkbibacro{DOI}\addcolon\space
  \ifhyperref
    {\href{https://doi.org/#1}{\nolinkurl{#1}}}
    {\nolinkurl{#1}}%
  \nopunct}

\renewbibmacro*{doi+eprint+url}{%
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \newunit\newblock
  \iftoggle{bbx:eprint}
    {\usebibmacro{eprint}}
    {}%
  \newunit\newblock
  \iftoggle{bbx:url}
    {\usebibmacro{url+urldate}}
    {}}

\NewBibliographyString{presentedat}
\DefineBibliographyStrings{english}{
  presentedat = presented at \addspace
}
\DeclareFieldFormat{eventtitle}{\emph{#1}}
\renewbibmacro*{event+venue+date}{%
  \iffieldundef{eventtitle}
    {}
    {%
      \bibstring{presentedat}\printfield{eventtitle}%
    }%
  \ifboolexpr{
    test {\iffieldundef{venue}}
    and
    test {\iffieldundef{eventyear}}
  }
    {}
    {\setunit*{\addspace}%
     \printtext[parens]{%
       \printfield{venue}%
       \setunit*{\addcomma\space}%
       \printeventdate}}%
  \newunit
}
%
% now override specific drivers below

\DeclareFieldFormat[misc]{title}{\mkbibquote{#1\isdot}}

\DeclareBibliographyDriver{poster}{%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \newunit
  \usebibmacro{title}
  \newunit\newblock
  \usebibmacro{event+venue+date}
  % \printfield{eventtitle}
  % \printfield{venue}.
  % \printfield{date}
  \usebibmacro{finentry}%
}
